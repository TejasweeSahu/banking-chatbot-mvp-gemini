# ── Gemini (the only LLM provider) ────────────────────────────────────────────
# Server-side only; never exposed to the browser. Leave empty to run the
# deterministic offline demo agent (no LLM) against the same banking tools.
GEMINI_API_KEY=
# Model name. If gemini-3.8-flash is slow/overloaded for your key, try gemini-3.5-flash.
GEMINI_MODEL=gemini-3.8-flash
# Per-request timeout (ms). Thinking models can be slow; timeouts are retried at most once.
GEMINI_TIMEOUT_MS=90000
# Retries for 429 / 5xx / network errors (exponential backoff with jitter; honours server retryDelay once).
GEMINI_MAX_RETRIES=3
# auto = stream, and fall back to non-streaming if a stream never starts; on | off to force.
GEMINI_STREAMING=auto
# Optional: low | medium | high (model-dependent). Optional temperature 0–2 (Gemini 3 recommends the default).
GEMINI_THINKING_LEVEL=
GEMINI_TEMPERATURE=

# ── Server ───────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
# Comma-separated list of browser origins allowed to call the API (CORS + CSRF origin check).
FRONTEND_ORIGIN=http://localhost:5173
# Set true when running behind a reverse proxy (correct client IPs for rate limiting).
TRUST_PROXY=false
LOG_LEVEL=info
LOGIN_RATE_LIMIT_PER_MIN=10

# ── Sessions ─────────────────────────────────────────────────────────────────
SESSION_TTL_MINUTES=480
SESSION_IDLE_MINUTES=30
# Secure cookies default to on in production. Only set false for a plain-http local preview.
COOKIE_SECURE=

# ── Data ─────────────────────────────────────────────────────────────────────
# SQLite file (Node's built-in node:sqlite). Created and seeded with mock data on first start.
DATABASE_PATH=
SEED_ON_START=true
# Pin "today" (YYYY-MM-DD) so the demo data and "this month" analytics are reproducible.
DEMO_ANCHOR_DATE=
